#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
#include <behaviors/hires_dial.dtsi>
#endif

/ {
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        bt_clear {
            slot = <0>;
            bindings = <&kp ESC>;
            key-positions = <37 38>;
            layers = <0>;
            display-name = "ESC";
        };

        /* Layer 0: J + K switches to Japanese kana input. */
        combo_kana {
            slot = <1>;
            bindings = <&kp LANGUAGE_1>;
            key-positions = <16 17>;
            layers = <0>;
            display-name = "Kana";
        };

        /* Layer 0: D + F switches to alphanumeric input. */
        combo_eisu {
            slot = <2>;
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
            layers = <0>;
            display-name = "Eisu";
        };
    };

        keymap {
            compatible = "zmk,keymap";

        layer_0 {
            status = "okay";
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp A  &kp S
                &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp MINUS  &mt LSHFT Z  &kp X  &kp C  &kp V
                &kp B  &kp LANGUAGE_2  &kp LANGUAGE_1  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SEMI  &kp LCTRL  &kp LGUI  &kp LALT  &kp BSPC
                &lt 3 SPACE  &lt 2 SPACE  &lt 1 RET  &kp BSPC  &kp BSPC  &kp RALT  &kp FSLH  &kp SQT  &mkp MCLK  &kp ESC  &kp N1  &kp N2
                &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC  &kp TAB  &kp BSPC  &kp CAPS
                &kp SQT  &kp LSHFT  &kp RSHFT  &kp LCTRL  &kp RCTRL  &trans
#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)\n                &mkp MCLK\n#endif
            >;
        };

        layer_1 {
            status = "okay";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp KP_ADD  &kp KP_MULTIPLY  &kp F1  &kp F2  &kp F3  &kp F4  &kp TAB  &kp N4
                &kp N5  &kp N6  &kp KP_SUBTRACT  &kp KP_DIVIDE  &kp F5  &kp F6  &kp F7  &kp F8  &kp CAPS  &kp N7  &kp N8  &kp N9
                &kp 34013229  &trans  &trans  &kp 34013218  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &kp N0  &trans
                &trans  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)\n                &mkp MCLK\n#endif
            >;
        };

        layer_2 {
            status = "okay";
            bindings = <
                &kp 34013214  &kp 34013240  &kp 34013216  &kp 34013217  &kp 34013219  &kp 34013221  &kp RBKT  &kp NON_US_HASH  &kp 34013222  &kp 34013230  &kp 34013227  &kp 34013215
                &kp 34013220  &kp 34013231  &kp 34013240  &kp 34013232  &kp 34013234  &kp MINUS  &kp LBKT  &kp SEMI  &kp LSHFT  &trans  &kp 34013233  &trans
                &trans  &trans  &trans  &kp 34013238  &kp 34013239  &kp FSLH  &kp KP_EQUAL  &kp SQT  &trans  &trans  &trans  &trans
                &trans  &trans  &kp LSHFT  &kp TAB  &kp DEL  &trans  &trans  &trans  &kp C_MUTE  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)\n                &kp C_MUTE\n#endif
            >;
        };

        layer_3 {
            status = "okay";
            bindings = <
                &trans  &trans  &trans  &trans  &kp PSCRN  &kp 17235996  &bt BT_NXT  &bt BT_PRV  &bt BT_CLR  &bt BT_CLR_ALL  &kp 17235972  &kp 17235990
                &kp 17235974  &kp 17235993  &kp END  &trans  &mkp LCLK  &kp UP  &mkp RCLK  &trans  &kp 17235997  &kp 17235995  &kp 17235997  &kp 17235996
                &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans  &trans  &trans  &kp DEL
                &kp TAB  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &hires_dial_radial_controller_button  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)\n                &hires_dial_radial_controller_button\n#endif
            >;
        };
        };
#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
&{/keymap/layer_0} {
    sensor-bindings = <&hires_dial_scroll 20 1>;
};

&{/keymap/layer_1} {
    sensor-bindings = <&hires_dial_scroll 1 1>;
};

&{/keymap/layer_2} {
    sensor-bindings = <&hires_dial_encoder C_VOL_UP C_VOL_DN>;
};

&{/keymap/layer_3} {
    /* Preserve the dedicated Radial Controller behavior. */
    sensor-bindings = <&hires_dial_radial_controller 4 1>;
};
#endif
